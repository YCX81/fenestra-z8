static void path_for(uint32_t id,char *out) {
 unsigned card=(id>>29)&3u,number=(id>>4)&0x7fffu;
 snprintf(out,64,"%c:\\DCIM\\108NCZ_8\\DSC_%04u.%s",card?'B':'A',number,(id&15u)==2u?"NEF":(id&15u)==5u?"MOV":"JPG");
}
static uint32_t native_path(uint32_t id,char *out) {
 /* The real formatter discards the requested low format and uses the group's primary. */
 path_for((id&~15u)|group_primary[(id>>29)&1u],out);return 0;
}
static uint32_t native_peer(uint32_t id,uint32_t which,uint64_t *out) {
 assert(which==2);assert(*out==0);peer_calls++;*out=peer_id|((uint64_t)peer_flags<<32);return peer_status;
}
static FakeFile *find_file(const char *path) {
 for(unsigned i=0;i<file_count;i++)if(files[i].exists&&!strcmp(files[i].path,path))return &files[i];
 return 0;
}
static FakeFile *add_file(const char *path,const void *bytes,uint64_t size) {
 assert(file_count<FILE_LIMIT);FakeFile *f=&files[file_count++];memset(f,0,sizeof(*f));
 snprintf(f->path,sizeof(f->path),"%s",path);f->exists=1;f->size=size;
 if(bytes){assert(size<=sizeof(f->bytes));memcpy(f->bytes,bytes,(size_t)size);}return f;
}
static void *native_member_ref(uint32_t id) {
 assert((id&15u)==0u);assert(!member_ref.active);char path[64];path_for(id,path);
 if(!find_file(path))return 0;
 member_ref.id=id;member_ref.active=1;strcpy(member_ref.path,path);ref_acquires++;return &member_ref;
}
static const char *native_member_path(void *ref) {assert(ref==&member_ref&&member_ref.active);return member_ref.path;}
static void native_member_release(void *ref) {assert(ref==&member_ref&&member_ref.active);member_ref.active=0;memset(member_ref.path,0xdd,sizeof member_ref.path);ref_releases++;}
static int32_t native_open(const char *path,uint32_t a,uint32_t b) {
 open_calls++;snprintf(last_open,sizeof(last_open),"%s",path);FakeFile *f=find_file(path);
 if(!f)return -1;f->pos=0;return (int32_t)(f-files)+10;
}
static FakeFile *fd_file(int32_t fd) {assert(fd>=10&&(unsigned)(fd-10)<file_count);return &files[fd-10];}
static uint32_t native_seek(int32_t fd,int64_t at,uint32_t whence,uint64_t *pos) {
 FakeFile *f=fd_file(fd);uint64_t p=whence==2?f->size+(uint64_t)at:(uint64_t)at;
 if(p>f->size)return 0;f->pos=p;*pos=p;return 1;
}
static uint32_t native_read(int32_t fd,void *out,uint32_t n,uint32_t *got) {
 FakeFile *f=fd_file(fd);if(f->pos+n>f->size)n=(uint32_t)(f->size-f->pos);
 assert(f->pos+n<=sizeof(f->bytes));memcpy(out,f->bytes+f->pos,n);f->pos+=n;*got=n;
 if(change_epoch_on_read){change_epoch_on_read=0;runtime.media_epoch++;}return 0;
}
static uint32_t native_close(int32_t fd) {(void)fd_file(fd);return 0;}
static uint32_t native_stat(const char *path,void *out) {snprintf(last_stat,sizeof(last_stat),"%s",path);return find_file(path)?0:1;}
static uint32_t native_setting(uint32_t key) {assert(key==0x4910);return setting_id;}
static void native_set_setting(uint32_t key,uint32_t value) {assert(key==0x4910);setting_id=value;}
static void *native_info(void *ref) {(void)ref;return original_info;}
static uintptr_t native_dir(uintptr_t slot,uint32_t directory) {assert(directory==108);return slot+0x400;}
static uintptr_t native_node(uintptr_t dir,uint32_t id,void *zero) {
 assert(!zero);if(node_missing)return 0;return dir+0xc00+(node_replaced?0x100:0);
}
static void native_slot_lock(uintptr_t lock,uint32_t a,uint32_t b) {(void)lock;assert(a==0x64&&b==0x64);}
static void native_slot_unlock(uintptr_t lock) {(void)lock;}
static uint32_t native_page(uint32_t kind,uint32_t page) {assert(kind==3);assert(page==0x56c||page==0x552);return 0x1234;}
static void native_busy(uint32_t value) {assert(value<=1);}
static void native_nop(void) {}
uint32_t pb_delete_original(uint32_t id,uint32_t flags) {delete_calls++;delete_last_id=id;return native_status;}
uint32_t pb_protect_original(void *obj,uint32_t value) {protect_calls++;protect_last_id=*(uint32_t*)((uint8_t*)obj+0x28);return native_status;}
static void (*native_function(uintptr_t address))(void) {
 switch(address) {
  case 0x407b95e4:return (void(*)(void))native_path;
  case 0x403fb59c:return (void(*)(void))native_peer;
  case 0x4085a8e0:return (void(*)(void))native_member_ref;
  case 0x4085c0d0:return (void(*)(void))native_member_path;
  case 0x4085aa7c:return (void(*)(void))native_member_release;
  case 0x402dd4f8:return (void(*)(void))native_open;
  case 0x402dd8e8:return (void(*)(void))native_seek;
  case 0x402dd6c8:return (void(*)(void))native_read;
  case 0x402dd558:return (void(*)(void))native_close;
  case 0x402dadf4:return (void(*)(void))native_stat;
  case 0x403ec398:return (void(*)(void))native_setting;
  case 0x403ec3a0:return (void(*)(void))native_set_setting;
  case 0x406bc37c:return (void(*)(void))native_info;
  case 0x4085e91c:return (void(*)(void))native_dir;
  case 0x4086c378:return (void(*)(void))native_node;
  case 0x40875834:return (void(*)(void))native_slot_lock;
  case 0x408758b4:return (void(*)(void))native_slot_unlock;
  case 0x403ad6a4:return (void(*)(void))native_page;
  case 0x403fb660:return (void(*)(void))native_busy;
  case 0x4085d348:case 0x4085d364:case 0x406364d0:return native_nop;
  default:fprintf(stderr,"Unexpected native function 0x%llx\n",(unsigned long long)address);abort();
 }
}

