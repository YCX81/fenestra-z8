 assert(runtime.cache_valid&&runtime.lookup_count==2&&runtime.lookup_epoch==runtime.media_epoch&&runtime.lookup_us==1100000);
 pass("stale_valid_publication_after_media_event_requeries_immediately");
 reset(RAW_A,JPG_B);add_live(JPG_B);run_worker(3,4);
 assert(runtime.cache_valid&&runtime.lookup_count==1&&runtime.lookup_epoch!=runtime.media_epoch&&runtime.pair_lock==1&&badge_requests==1);
 assert(!press_rec());runtime.pair_lock=0;pass("stale_epoch_cache_cannot_publish_badge_or_own_REC_while_pair_locked");
 reset(RAW_A,0);run_worker(8,5);
 assert(!runtime.cache_valid&&runtime.lookup_count==2&&runtime.lookup_epoch==runtime.media_epoch&&runtime.lookup_us==1100000);
 pass("failed_lookup_records_new_epoch_and_does_not_retry_each_poll");
}
static void test_pair_lock(void) {
 reset(RAW_A,JPG_B);add_live(JPG_B);do_lookup();runtime.pair_lock=1;nb_start(&runtime);
 assert(!runtime.nb_stage&&!runtime.nb_starts&&runtime.pair_lock==1&&*mask_for(RAW_A,0)==4);pass("worker_held_pair_lock_prevents_start_without_unlocking_owner");
 runtime.pair_lock=0;nb_start(&runtime);assert(runtime.nb_stage==2&&runtime.pair_lock==0);pass("successful_start_releases_pair_lock");
 reset(RAW_A,JPG_B);add_live(JPG_B);do_lookup();runtime.cached_id=OTHER_A;nb_start(&runtime);
 assert(!runtime.nb_stage&&runtime.nb_fail==1&&runtime.pair_lock==0);pass("invalid_cache_start_releases_pair_lock");
 reset(RAW_A,JPG_B);add_live(JPG_B);do_lookup();node_missing=1;nb_start(&runtime);
 assert(!runtime.nb_stage&&runtime.nb_fail==2&&runtime.pair_lock==0);pass("missing_node_start_releases_pair_lock");
 reset(RAW_A,JPG_B);add_live(JPG_B);runtime.pair_lock=1;run_worker(2,0);
 assert(runtime.lookup_count==0&&runtime.pair_lock==1);runtime.pair_lock=0;run_worker(2,0);
 assert(runtime.cache_valid&&runtime.lookup_count==1&&!runtime.pair_lock);pass("worker_skips_locked_pairing_and_releases_after_lookup");
 reset(RAW_A,0);run_worker(2,0);assert(!runtime.cache_valid&&runtime.lookup_count==1&&!runtime.pair_lock);pass("failed_worker_lookup_releases_pair_lock");
}
static void test_per_card_lifecycle(void) {
 for(unsigned source_card=0;source_card<2;source_card++)for(uint32_t event=22;event<=31;event++)for(unsigned on_source=0;on_source<2;on_source++){
  uint32_t origin=source_card?RAW_B:RAW_A,target=source_card?JPG_A:JPG_B;
  reset(origin,target);add_live(target);do_lookup();expect_ready(origin,target);nb_start(&runtime);assert(runtime.nb_stage==2);
  uint32_t epoch=runtime.media_epoch,source_epoch=runtime.card_epoch[source_card],target_epoch=runtime.card_epoch[1-source_card];
  unsigned affected=on_source?source_card:1-source_card;emit_event(event,affected);
  assert(runtime.media_epoch==epoch+1&&!runtime.cache_valid&&runtime.sync_reset&&runtime.sync.generation==0);
  assert(runtime.card_epoch[source_card]==source_epoch+(on_source?1u:0u));
  assert(runtime.card_epoch[1-source_card]==target_epoch+(on_source?0u:1u));
  assert(!nb_match(&runtime,runtime.nb_from)&&pb_info_record(0)==original_info);
  uint32_t movie=runtime.nb_movie;assert(setting_id==movie);pb_native_return(3,0x552);
  assert(runtime.nb_stage==3&&setting_id==(on_source?movie:origin));
  nb_end(&runtime);assert(runtime.nb_stage==0&&runtime.nb_bit==0);
  assert(*mask_for(origin,0)==(on_source?0x24:4));
  char label[96];snprintf(label,sizeof label,"event_%u_%c_source_%s_card_return_and_cleanup",event,source_card?'B':'A',on_source?"changed_source":"changed_peer");pass(label);
 }
 for(unsigned source_card=0;source_card<2;source_card++)for(unsigned which=0;which<2;which++){
  uint32_t origin=source_card?RAW_B:RAW_A,target=source_card?JPG_A:JPG_B;
  reset(origin,target);add_live(target);do_lookup();nb_start(&runtime);uint32_t e0=runtime.card_epoch[0],e1=runtime.card_epoch[1];
  emit_event(23,which?UINT32_MAX:2u);assert(runtime.card_epoch[0]==e0+1&&runtime.card_epoch[1]==e1+1);
  uint32_t movie=runtime.nb_movie;pb_native_return(3,0x552);assert(setting_id==movie);nb_end(&runtime);assert(*mask_for(origin,0)==0x24);
  char label[96];snprintf(label,sizeof label,"invalid_slot_%s_%c_source_invalidates_both_and_preserves_reused_node",which?"UINT32_MAX":"2",source_card?'B':'A');pass(label);
 }
 for(unsigned source_card=0;source_card<2;source_card++){
  uint32_t origin=source_card?RAW_B:RAW_A,target=source_card?JPG_A:JPG_B;
  reset(origin,target);add_live(target);do_lookup();nb_start(&runtime);uint32_t movie=runtime.nb_movie;
  emit_event(23,1-source_card);for(unsigned i=0;i<file_count;i++)if(files[i].path[0]==(source_card?'A':'B'))files[i].exists=0;
  selected_id=movie;assert(setting_id==movie&&active);run_worker(14,0);
  assert(!runtime.nb_stage&&!runtime.nb_bit&&runtime.nb_cleanups==1&&*mask_for(origin,0)==4&&runtime.ui_leaving==0);
  char label[96];snprintf(label,sizeof label,"peer_remove_%c_source_times_out_even_when_4910_still_movie",source_card?'B':'A');pass(label);
 }
 reset(RAW_A,JPG_B);add_live(JPG_B);do_lookup();uint32_t epoch=runtime.media_epoch;
 emit_event(21,0);emit_event(32,1);assert(runtime.media_epoch==epoch&&runtime.cache_valid);pass("unrelated_events_do_not_invalidate_pairing");
}
static void run_cases(void) {
 setvbuf(stdout,0,_IONBF,0);
 test_playback(RAW_A,JPG_B,"A_RAW_to_B_Live_return_delay_redirect_and_fast_REC");
 test_playback(RAW_B,JPG_A,"B_RAW_to_A_Live_return_delay_redirect_and_fast_REC");
 test_playback(JPG_A,JPG_A,"original_A_JPG_direct_Live_preserved");
 test_playback(JPG_B,JPG_B,"original_B_JPG_direct_Live_preserved");
 test_playback(RAW_A,JPG_A,"same_card_A_NEF_exact_JPG_member_Live");
 test_playback(RAW_B,JPG_B,"same_card_B_NEF_exact_JPG_member_Live");
 test_rejections();test_bridge_guards();test_sync_guards();test_worker_retry();test_pair_lock();test_per_card_lifecycle();
}

int main(void) {map_native_memory();run_cases();return 0;}
